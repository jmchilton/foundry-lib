{
  "name": "foundry-lib",
  "private": true,
  "type": "module",
  "description": "Shared substrate packages for Foundry-pattern instances.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "smoke": "node scripts/smoke-packages.mjs",
    "docs:dev": "docsify serve docs",
    "docs:api": "typedoc",
    "docs:build": "pnpm build && pnpm docs:api",
    "docs:check": "pnpm docs:build && node scripts/check-doc-links.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "docsify-cli": "^4.4.4",
    "prettier": "^3.4.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
