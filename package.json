{
  "name": "foundry-lib",
  "private": true,
  "type": "module",
  "description": "Shared substrate packages for Foundry-pattern instances.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint packages/*/src/ packages/*/test/",
    "lint:unused": "knip",
    "lint:unused:ci": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "lint:packages": "pnpm --filter \"./packages/*\" exec publint && pnpm --filter \"./packages/*\" exec attw --pack . --profile esm-only --entrypoints .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "smoke": "node scripts/smoke-packages.mjs",
    "docs:dev": "docsify serve docs",
    "docs:api": "typedoc",
    "docs:build": "pnpm build && pnpm docs:api",
    "docs:check": "pnpm docs:build && node scripts/check-doc-links.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^10.0.1",
    "docsify-cli": "^4.4.4",
    "eslint": "^10.1.0",
    "knip": "^6.4.1",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=20"
  }
}
