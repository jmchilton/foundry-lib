{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/audit-citations",
    "packages/cast",
    "packages/kind-manifest",
    "packages/kind-schema",
    "packages/license-policy",
    "packages/content-reader",
    "packages/reference-contract",
    "packages/site-kit",
    "packages/tag-registry",
    "packages/wiki-links"
  ],
  "entryPointStrategy": "packages",
  "highlightLanguages": ["ts", "js", "json", "bash", "sh", "css", "yaml", "astro"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "readme": "README.md",
    "excludeInternal": true,
    "excludePrivate": true,
    "gitRevision": "main"
  },
  "out": "docs/api/typedoc",
  "json": "docs/api/typedoc.json",
  "name": "foundry-lib API",
  "readme": "none",
  "hostedBaseUrl": "https://jmchilton.github.io/foundry-lib/api/typedoc/",
  "navigationLinks": {
    "Guides": "https://jmchilton.github.io/foundry-lib/#/getting-started",
    "The Foundry Pattern": "https://galaxyproject.github.io/foundry-pattern/",
    "GitHub": "https://github.com/jmchilton/foundry-lib",
    "npm": "https://www.npmjs.com/org/galaxy-foundry"
  },
  "validation": {
    "invalidLink": true,
    "notExported": false
  }
}
