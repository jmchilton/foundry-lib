{
  "name": "@galaxy-foundry/audit-citations",
  "version": "0.2.1",
  "description": "Deterministic scholarly-citation extraction, resolution, evidence capture, and audit reporting.",
  "type": "module",
  "bin": {
    "foundry-audit-citations": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmchilton/foundry-lib.git",
    "directory": "packages/audit-citations"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "citations",
    "audit",
    "provenance",
    "scholarly-metadata",
    "foundry"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
