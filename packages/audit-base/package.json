{
  "name": "@galaxy-foundry/audit-base",
  "version": "0.0.0",
  "description": "The audit lifecycle shapes shared by Foundry checkers \u2014 digest-bound spans, corpus identity, and reviewed decisions \u2014 with no checker's vocabulary in them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmchilton/foundry-lib.git",
    "directory": "packages/audit-base"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "audit",
    "provenance",
    "adjudication",
    "foundry",
    "zod"
  ],
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
