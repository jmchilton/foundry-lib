{
  "name": "@galaxy-foundry/cast",
  "version": "0.12.0",
  "description": "The deterministic half of casting for Foundry-pattern instances — bundle placement, drift reconciliation, and the provenance record. The kinds, slug map and renderers stay per-instance.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmchilton/foundry-lib.git",
    "directory": "packages/cast"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "foundry",
    "cast",
    "provenance",
    "determinism",
    "skill"
  ],
  "license": "MIT",
  "dependencies": {
    "@galaxy-foundry/kind-manifest": "workspace:^",
    "@galaxy-foundry/license-policy": "workspace:^",
    "@galaxy-foundry/reference-contract": "workspace:^",
    "@galaxy-foundry/wiki-links": "workspace:^",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
