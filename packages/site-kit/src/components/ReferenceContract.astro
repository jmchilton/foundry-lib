---
import {
  REFERENCE_CHIP_FIELDS,
  REFERENCE_FIELDS,
  type ContractGroup,
  type ContractTerm,
  type Standing,
} from '@galaxy-foundry/reference-contract';
import type { ReferenceContractProps } from '../index.js';

/**
 * A note's typed reference manifest, rendered from the contract it was authored against.
 *
 * This arrived as a copy in one instance and as nothing at all in the other — which is the more
 * interesting half. The second site depended on `@galaxy-foundry/reference-contract`, loaded it,
 * wired it into its registries, validated twelve notes' worth of `references:` against it, and had
 * no component that read any of it. The package shipped the vocabulary and left the view to be
 * reinvented, so one instance reinvented it and one never got round to it. Nothing failed.
 *
 * Every group's terms are looked up through {@link REFERENCE_FIELDS} rather than named here. The
 * copy this replaces spelled the five field-to-group pairs out by hand a second time — `kind` for
 * `kinds`, `mode` for `modes` — to look each label up, and the schema had spelled them a third.
 * Three lists, no two of which anything compared.
 */
type Props = ReferenceContractProps;

const { references, contract, resolveRef } = Astro.props;

/**
 * A term, or a stand-in that says so.
 *
 * A value outside its vocabulary should not reach a page — the schema refuses it at build. If one
 * does, it renders as itself with the reason attached, rather than throwing on a reader's request
 * or, worse, rendering as a blank chip that looks like a term with a short label.
 */
function term(group: ContractGroup, key: string): ContractTerm & { standing?: Standing } {
  return (
    contract[group][key] ?? {
      label: key,
      description: `Not a registered \`${group}\` value.`,
    }
  );
}

/**
 * What a pill IS, decided by whether it has anywhere to go.
 *
 * The four inherited vocabularies carry spec URLs, so their chips are links. `kinds` is the
 * instance's own, and an instance need not have a page to point a reader at.
 *
 * An `<a>` with no `href` is valid HTML and is not a link: not focusable, not clickable, announced
 * as plain text — while carrying the same pill styling as the real links beside it. It looks like
 * something to click and is nothing. The affordance worth keeping is the description, and a
 * `<span>` carries that just as well.
 */
const pill = (href?: string): 'a' | 'span' => (href ? 'a' : 'span');
---
{references.length > 0 && (
  <section class="reference-contract">
    <div class="reference-contract-head">
      <span class="reference-contract-eyebrow">
        <span class="reference-contract-rule" aria-hidden="true"></span>
        <span>contract</span>
      </span>
      <h2>Reference Loading</h2>
      <p>Typed references describe what casting consumes, and when the generated skill should load each artifact.</p>
    </div>
    <div class="reference-grid">
      {references.map(reference => {
        const kind = term('kinds', reference.kind);
        const Kind = pill(kind.href);
        const link = resolveRef?.(reference.ref) ?? null;
        const detail = ([['Purpose', reference.purpose], ['Trigger', reference.trigger], ['Verify', reference.verification]] as const)
          .filter(([, value]) => Boolean(value));
        return (
          <article class="reference-card" data-kind={reference.kind}>
            <header class="reference-card-top">
              <Kind class="pill kind" href={kind.href} title={kind.description}>{kind.label}</Kind>
              <span class="ref">
                {link
                  ? link.href
                    ? <a href={link.href} title={link.summary || undefined}>{link.label}</a>
                    : <span class="dangling">{link.label}</span>
                  : reference.ref}
              </span>
            </header>
            <p class="kind-help">{kind.description}</p>
            <div class="chips" aria-label="loading metadata">
              {REFERENCE_CHIP_FIELDS.map(field => {
                const chip = term(REFERENCE_FIELDS[field], reference[field]);
                const Chip = pill(chip.href);
                return (
                  <Chip class="pill" href={chip.href} title={chip.description} data-standing={chip.standing}>{chip.label}</Chip>
                );
              })}
            </div>
            {detail.length > 0 && (
              <dl class="reference-card-detail">
                {detail.map(([label, value]) => (
                  <Fragment>
                    <dt data-field={label.toLowerCase()}>{label}</dt>
                    <dd data-field={label.toLowerCase()}>{value}</dd>
                  </Fragment>
                ))}
              </dl>
            )}
          </article>
        );
      })}
    </div>
  </section>
)}

<style>
  .reference-contract {
    position: relative;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 1rem;
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--color-brand) 4%, transparent),
        transparent 40%),
      var(--color-surface-raised);
    padding: 1.25rem 1.25rem 1.1rem;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-brand) 6%, transparent);
  }
  .reference-contract-head {
    margin-bottom: 1.1rem;
  }
  .reference-contract-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .reference-contract-rule {
    width: 1.25rem;
    height: 2px;
    background: var(--color-accent);
  }
  .reference-contract h2 {
    margin: 0.35rem 0 0.3rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .reference-contract-head p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    max-width: 60ch;
    line-height: 1.5;
  }
  .kind-help {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.45;
    margin: 0;
  }
  .reference-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.85rem;
  }
  .reference-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.7rem;
    background: var(--color-surface);
    padding: 0.95rem 1rem 0.95rem 1.15rem;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  /* Which kinds exist is the instance's to say, so the accent is a property it sets through
     `[data-kind="…"]` rather than a selector shipped here for four names one site happened to
     author. The brand behind it is a real answer for a kind nobody tinted, not a missing one. */
  .reference-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    bottom: 0.7rem;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--color-kind-accent, var(--color-brand));
    opacity: 0.55;
  }
  .reference-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-border-subtle));
    transform: translateY(-1px);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-chrome) 6%, transparent),
      0 6px 14px color-mix(in srgb, var(--color-chrome) 7%, transparent);
  }
  .reference-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .kind {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .ref {
    font-size: 0.92rem;
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
    letter-spacing: -0.005em;
  }
  .ref a {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-link) 25%, transparent);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .ref a:hover {
    color: var(--color-link-hover);
    border-color: var(--color-accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .chips .pill {
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.35rem;
    padding: 0.16rem 0.5rem;
    color: var(--color-text-secondary);
    background: var(--color-surface-raised);
  }
  /* `a.pill`, not `.pill` — a chip whose term has no destination renders as a `<span>`, and a
     non-link that lights up under the cursor promises a click it cannot honour. */
  .chips a.pill:hover {
    color: var(--color-link);
    border-color: var(--color-accent);
    background: var(--color-surface-hover);
  }
  /* Styled by what the term declares itself to be, not by its name. The version this replaces
     listed `.evidence-corpus-observed, .evidence-cast-validated` — a copy of the vocabulary table
     kept where the table could not see it, and silently no opinion at all about a fourth term. */
  .chips .pill[data-standing="provisional"] {
    color: var(--color-evidence-provisional-text);
    background: var(--color-evidence-provisional-bg);
    border-color: color-mix(in srgb, var(--color-evidence-provisional-text) 30%, transparent);
  }
  .chips .pill[data-standing="grounded"] {
    color: var(--color-evidence-grounded-text);
    background: var(--color-evidence-grounded-bg);
    border-color: color-mix(in srgb, var(--color-evidence-grounded-text) 30%, transparent);
  }
  .reference-card-detail {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 0.7rem;
    row-gap: 0.3rem;
    margin: 0.1rem 0 0;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--color-border-subtle);
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .reference-card-detail dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: 0.18rem;
  }
  .reference-card-detail dd {
    margin: 0;
    color: var(--color-text-secondary);
  }
  /* `verification` is the field a provisional term is required to carry, so it wears that
     standing's colour — one decision, not a second palette that happens to match. */
  .reference-card-detail dt[data-field="verify"] {
    color: var(--color-evidence-provisional-text);
  }
  .reference-card-detail dd[data-field="verify"] {
    color: var(--color-text-primary);
    padding-left: 0.55rem;
    border-left: 2px solid var(--color-evidence-provisional-text);
  }
</style>
