---
import type { ContentNoteProps as Props } from '../index.js';
import NoteHeader from './NoteHeader.astro';

const { articleClass = '', ...header } = Astro.props;
---
<div class="content-note">
  <NoteHeader {...header}>
    <slot name="badges" slot="badges" />
  </NoteHeader>

  <slot name="metadata" />
  <slot name="reference" />

  <article class={articleClass}>
    <slot />
  </article>
</div>
