---
import { CONTAINER, type SiteShellProps } from '../index.js';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

/**
 * The reading shell: document skeleton, header, footer, and the page in between.
 *
 * The kit brings no stylesheet of its own. Every class below is either a Tailwind utility or a name
 * the INSTANCE has to supply — the six in {@link SHELL_TOKENS} and the three in
 * {@link SHELL_CLASSES}. Tailwind also has to be pointed at this package's `src/`, or none of the
 * utilities here reach the instance's stylesheet at all. All of it fails SILENTLY: a green build
 * and an unstyled page. Assert with {@link shellStyleGaps}; see the README.
 *
 * The other silent contract is the search index, which the header renders a box for and nothing
 * fills. `<main>` carries {@link PAGEFIND_BODY_ATTR} unless a page opts out; assert the whole
 * built site with {@link searchIndexGaps}.
 */
type Props = SiteShellProps;

const { title, base, pathname, identity } = Astro.props;
const { description = identity.description, searchable = true } = Astro.props;
const fullTitle = `${title} - ${identity.name}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    const dark = localStorage.theme === 'dark' ||
      (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', dark);
    // Pagefind's component UI reads its palette off this attribute, not our `.dark` class.
    document.documentElement.dataset.pfTheme = dark ? 'dark' : 'light';
  </script>
</head>
<body class="min-h-dvh flex flex-col bg-(--color-surface) text-(--color-text-primary)">
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteHeader
    base={base}
    pathname={pathname}
    name={identity.name}
    navLinks={identity.navLinks}
    navVisible={identity.navVisible}
  />
  <main
    id="main"
    class={`flex-1 bg-grid ${CONTAINER} w-full mx-auto px-4 sm:px-6 py-6 leading-relaxed`}
    data-pagefind-body={searchable ? true : undefined}
  >
    <slot />
  </main>
  <SiteFooter
    base={base}
    fullName={identity.fullName}
    repoUrl={identity.repoUrl}
    footerLinks={identity.footerLinks}
  />
</body>
</html>
