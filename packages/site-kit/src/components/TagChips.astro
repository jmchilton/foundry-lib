---
import type { TagChipsProps as Props } from '../index.js';

const { tags, tagBase } = Astro.props;
---
<span class="tag-chips" aria-label="Tags">
  {tags.map((tag) => tagBase
    ? <a href={`${tagBase}/${tag}/`} class="content-tag">{tag}</a>
    : <span class="content-tag">{tag}</span>)}
</span>

<style>
  .tag-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* A tag is a way in, so it is coloured as one. The bordered mono pill this used to draw is what
     both adopting instances use for frontmatter shown as written — same surface, same border, same
     face — so a chip matching it tells the reader nothing about which of the two is clickable.
     Both instances had already removed that pill before the package reintroduced it. */
  .content-tag {
    display: inline-block;
    border-radius: 999px;
    background: var(--color-surface-hover);
    color: var(--color-link);
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* Only the anchor lights up. An unlinked chip that changed on hover would promise a destination
     the instance has not built. */
  a.content-tag:hover {
    background: var(--color-accent);
    color: var(--color-chrome);
  }
</style>
