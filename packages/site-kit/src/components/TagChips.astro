---
import type { TagChipsProps as Props } from '../index.js';

const { tags, tagBase } = Astro.props;
---
<span class="tag-chips" aria-label="Tags">
  {tags.map((tag) => tagBase
    ? <a href={`${tagBase}/${tag}/`} class="content-tag">{tag}</a>
    : <span class="content-tag">{tag}</span>)}
</span>

<style>
  .tag-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .content-tag {
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  a.content-tag:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
</style>
