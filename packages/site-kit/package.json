{
  "name": "@galaxy-foundry/site-kit",
  "version": "0.5.0",
  "description": "The reading shell for Foundry-pattern instances — document skeleton, header with derived nav, and footer, as Astro components taking a site's identity as data. The values, the styles and the corpus stay per-instance.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./specimens": {
      "types": "./dist/specimens.d.ts",
      "import": "./dist/specimens.js"
    },
    "./SiteShell.astro": "./src/components/SiteShell.astro",
    "./SiteHeader.astro": "./src/components/SiteHeader.astro",
    "./SiteFooter.astro": "./src/components/SiteFooter.astro",
    "./ReferenceContract.astro": "./src/components/ReferenceContract.astro",
    "./LicenseBadge.astro": "./src/components/LicenseBadge.astro",
    "./LicenseFileBody.astro": "./src/components/LicenseFileBody.astro"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmchilton/foundry-lib.git",
    "directory": "packages/site-kit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "foundry",
    "astro",
    "site",
    "layout",
    "navigation"
  ],
  "license": "MIT",
  "dependencies": {
    "@galaxy-foundry/license-policy": "workspace:^",
    "@galaxy-foundry/reference-contract": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=6",
    "astro-pagefind": ">=2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "astro": "^7.1.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
